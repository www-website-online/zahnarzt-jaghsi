[Unit]
Description=Verified Zahnarzt content backup

[Service]
Type=oneshot
User=www-data
Group=www-data
UMask=0077
ExecStart=/var/www/zahnarzt-jaghsi/.venv/bin/python /var/www/zahnarzt-jaghsi/scripts/content_backup.py create
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/zahnarzt /var/backups/zahnarzt
